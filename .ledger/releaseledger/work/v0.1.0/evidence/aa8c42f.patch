+# This workflow builds and publishes the Python package when a release is created.
+
+name: Upload Python Package
+
+on:
+  release:
+    types: [published]
+
+permissions:
+  contents: read
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.x"
+      - name: Resolve expected release version
+        run: |
+          tag="${{ github.event.release.tag_name }}"
+          if [[ "$tag" == v* ]]; then
+            tag="${tag#v}"
+          fi
+          echo "EXPECTED_VERSION=$tag" >> "$GITHUB_ENV"
+      - name: Install build tools
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install -e ".[dev]" pytest-cov build twine
+      - name: Run the release quality gate
+        run: |
+          python -m pytest
+          python -X dev -W error::ResourceWarning -m pytest
+          python -m pytest \
+            --cov=pronresolve \
+            --cov-branch \
+            --cov-report=term-missing \
+            --cov-fail-under=70
+          python -m ruff check . --select E,F
+          python -m ruff format --check .
+          python -m mypy pronresolve
+      - name: Build and validate distributions
+        run: |
+          rm -rf dist build
+          python -m build
+          python -m twine check dist/*
+      - name: Smoke test wheel in a clean environment
+        run: |
+          smoke_dir="$RUNNER_TEMP/pronresolve-release-smoke"
+          mkdir -p "$smoke_dir"
+          cat > "$smoke_dir/entries.jsonl" <<'JSONL'
+          {"word":"lead","pos":"NOUN","pronunciations":[{"ipa":"liːd"}],"senses":[{"sense_id":"metal","glosses":["a heavy metal"]}]}
+          {"word":"lead","pos":"NOUN","pronunciations":[{"ipa":"lɛd"}],"senses":[{"sense_id":"guide","glosses":["to guide or direct"]}]}
+          JSONL
+          python -m venv .release-smoke
+          .release-smoke/bin/python -m pip install --upgrade pip
+          .release-smoke/bin/python -m pip install dist/*.whl
+          .release-smoke/bin/python - <<'PY'
+          import os
+          import pronresolve
+          expected = os.environ["EXPECTED_VERSION"]
+          actual = pronresolve.__version__
+          assert actual == expected and actual != "0+unknown", (expected, actual)
+          print(actual)
+          PY
+          .release-smoke/bin/pronresolve --help
+          .release-smoke/bin/pronresolve build \
+            --input-jsonl "$smoke_dir/entries.jsonl" \
+            --output "$smoke_dir/index.json" \
+            --language en \
+            --locale en-US
+          .release-smoke/bin/pronresolve inspect "$smoke_dir/index.json"
+          .release-smoke/bin/pronresolve validate "$smoke_dir/index.json"
+      - name: Publish package
+        uses: pypa/gh-action-pypi-publish@v1.13.0
+        with:
+          user: __token__
+          password: ${{ secrets.PYPI_API_TOKEN }}
