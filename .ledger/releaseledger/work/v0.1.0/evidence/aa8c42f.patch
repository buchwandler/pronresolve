+"""Command-line tools for building and inspecting ambiguity indexes."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+from typing import Any
+from collections.abc import Iterable
+
+from .discovery import discover_ambiguities
+from .storage import load_index, save_index
+
+
+def _jsonl_entries(path: Path) -> Iterable[dict[str, Any]]:
+    with path.open("r", encoding="utf-8") as stream:
+        for line_number, line in enumerate(stream, start=1):
+            if not line.strip():
+                continue
+            try:
+                value = json.loads(line)
+            except json.JSONDecodeError as exc:
+                raise ValueError(f"{path}:{line_number}: invalid JSON: {exc}") from exc
+            if not isinstance(value, dict):
+                raise ValueError(f"{path}:{line_number}: each JSONL record must be an object")
+            yield value
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="pronresolve")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    build = subparsers.add_parser("build", help="build an ambiguity index from JSONL entries")
+    build.add_argument("--input-jsonl", required=True, type=Path)
+    build.add_argument("--output", required=True, type=Path)
+    build.add_argument("--language", required=True)
+    build.add_argument("--locale")
+
+    inspect = subparsers.add_parser("inspect", help="print index summary")
+    inspect.add_argument("index", type=Path)
+
+    validate = subparsers.add_parser("validate", help="validate an index schema")
+    validate.add_argument("index", type=Path)
+
+    args = parser.parse_args(argv)
+    try:
+        if args.command == "build":
+            result = discover_ambiguities(
+                _jsonl_entries(args.input_jsonl),
+                language=args.language,
+                locale=args.locale,
+            )
+            save_index(result.index, args.output)
+            report_path = args.output.with_name(args.output.name + ".report.json")
+            report_path.write_text(
+                json.dumps(result.report.as_dict(), ensure_ascii=False, indent=2, sort_keys=True)
+                + "\n",
+                encoding="utf-8",
+            )
+            print(
+                json.dumps(
+                    {
+                        "index": str(args.output),
+                        "report": str(report_path),
+                        **result.report.as_dict(),
+                    },
+                    ensure_ascii=False,
+                    indent=2,
+                )
+            )
+            return 0
+
+        index = load_index(args.index)
+        summary = {
+            "valid": True,
+            "schema_version": index.schema_version,
+            "language": index.language,
+            "locale": index.locale,
+            "profile_count": len(index.profiles),
+            "ambiguous_words": len({profile.word.casefold() for profile in index.profiles}),
+        }
+        print(json.dumps(summary, ensure_ascii=False, indent=2))
+        return 0
+    except (OSError, ValueError, json.JSONDecodeError) as exc:
+        print(f"pronresolve: error: {exc}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/pronresolve/discovery.py b/pronresolve/discovery.py
new file mode 100644
index 0000000..1a4a1db
--- /dev/null
+++ b/pronresolve/discovery.py
@@ -0,0 +1,242 @@
+"""Discover resolvable same-spelling, same-POS pronunciation differences."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import unicodedata
+from collections import defaultdict
+from collections.abc import Iterable, Mapping
+from typing import Any
+
+from .models import AmbiguityIndex, DiscoveryReport, DiscoveryResult, ReadingProfile
+from .normalization import normalize_ipa, normalize_pos, normalize_word
+
+_LANG_RE = re.compile(r"[^a-z0-9]+")
+
+
+def _field(value: Any, name: str, default: Any = None) -> Any:
+    if isinstance(value, Mapping):
+        return value.get(name, default)
+    return getattr(value, name, default)
+
+
+def _as_sequence(value: Any) -> tuple[Any, ...]:
+    if value is None:
+        return ()
+    if isinstance(value, (str, bytes)):
+        return (value,) if value else ()
+    try:
+        return tuple(value)
+    except TypeError:
+        return (value,)
+
+
+def _unique_text(values: Iterable[Any]) -> tuple[str, ...]:
+    result: list[str] = []
+    seen: set[str] = set()
+    for value in values:
+        text = unicodedata.normalize("NFC", str(value or "")).strip()
+        if text and text not in seen:
+            seen.add(text)
+            result.append(text)
+    return tuple(result)
+
+
+def _related_text(value: Any) -> str:
+    if isinstance(value, str):
+        return value
+    return str(_field(value, "word", "") or "")
+
+
+def _example_text(value: Any) -> str:
+    if isinstance(value, str):
+        return value
+    return str(_field(value, "text", "") or "")
+
+
+def _pronunciations(entry: Any) -> tuple[tuple[str, tuple[str, ...]], ...]:
+    raw = _field(entry, "pronunciations")
+    if raw is None:
+        raw = _field(entry, "sounds", ())
+    result: list[tuple[str, tuple[str, ...]]] = []
+    seen: set[str] = set()
+    for item in _as_sequence(raw):
+        ipa = normalize_ipa(str(_field(item, "ipa", "") or ""))
+        if not ipa or ipa in seen:
+            continue
+        seen.add(ipa)
+        tags = _unique_text(_as_sequence(_field(item, "tags", ())))
+        result.append((ipa, tags))
+    return tuple(result)
+
+
+def _entry_evidence(entry: Any) -> dict[str, tuple[str, ...]]:
+    sense_ids: list[str] = []
+    glosses: list[str] = []
+    topics: list[str] = []
+    tags: list[str] = []
+    examples: list[str] = []
+    synonyms: list[str] = []
+    antonyms: list[str] = []
+
+    for sense in _as_sequence(_field(entry, "senses", ())):
+        sense_id = _field(sense, "sense_id")
+        if sense_id:
+            sense_ids.append(str(sense_id))
+        glosses.extend(_as_sequence(_field(sense, "glosses", ())))
+        topics.extend(_as_sequence(_field(sense, "topics", ())))
+        tags.extend(_as_sequence(_field(sense, "tags", ())))
+        examples.extend(_example_text(item) for item in _as_sequence(_field(sense, "examples", ())))
+        synonyms.extend(_related_text(item) for item in _as_sequence(_field(sense, "synonyms", ())))
+        antonyms.extend(_related_text(item) for item in _as_sequence(_field(sense, "antonyms", ())))
+
+    return {
+        "sense_ids": _unique_text(sense_ids),
+        "etymology_numbers": _unique_text((_field(entry, "etymology_number"),)),
+        "glosses": _unique_text(glosses),
+        "topics": _unique_text(topics),
+        "tags": _unique_text(tags),
+        "examples": _unique_text(examples),
+        "synonyms": _unique_text(synonyms),
+        "antonyms": _unique_text(antonyms),
+    }
+
+
+def reading_id_for(language: str, word: str, pos: str, ipa: str) -> str:
+    """Return a stable ID for a reading, independent of input order."""
+    lang = _LANG_RE.sub("-", normalize_word(language)).strip("-") or "und"
+    payload = json.dumps(
+        [
+            normalize_word(language),
+            normalize_word(word),
+            normalize_pos(pos),
+            normalize_ipa(ipa),
+        ],
+        ensure_ascii=False,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    digest = hashlib.blake2s(payload, digest_size=8, person=b"prnrs1").hexdigest()
+    return f"r1-{lang}-{digest}"
+
+
+def discover_ambiguities(
+    entries: Iterable[Any],
+    *,
+    language: str,
+    locale: str | None = None,
+) -> DiscoveryResult:
+    """Scan dictionary-entry objects and create profiles only when sense linkage is safe.
+
+    Entries can be Lexhint ``DictionaryEntry`` instances or mappings with the same
+    fields. Entries are consumed once, so generators and streaming iterators work.
+    """
+    grouped: dict[tuple[str, str], list[dict[str, Any]]] = defaultdict(list)
+    entries_scanned = 0
+    entries_without_pronunciation = 0
+
+    for entry in entries:
+        entries_scanned += 1
+        raw_word = str(_field(entry, "word", "") or "").strip()
+        if not raw_word:
+            continue
+        word = normalize_word(raw_word)
+        pos = normalize_pos(str(_field(entry, "pos", "") or "ENTRY"))
+        pronunciations = _pronunciations(entry)
+        if not pronunciations:
+            entries_without_pronunciation += 1
+            continue
+        grouped[(word, pos)].append(
+            {
+                "word": raw_word,
+                "pronunciations": pronunciations,
+                "evidence": _entry_evidence(entry),
+            }
+        )
+
+    profiles: list[ReadingProfile] = []
+    ambiguous_keys = 0
+    resolvable_keys = 0
+    unlinked_ambiguity_keys = 0
+    non_ambiguous_keys = 0
+    unlinked_keys: list[str] = []
+
+    for (normalized_word, pos), entry_rows in sorted(grouped.items()):
+        all_ipa = {ipa for row in entry_rows for ipa, _tags in row["pronunciations"]}
+        if len(all_ipa) <= 1:
+            non_ambiguous_keys += 1
+            continue
+
+        ambiguous_keys += 1
+
+        # An entry carrying multiple IPA values does not tell us which sense maps
+        # to which IPA. Do not silently attach all its senses to every reading.
+        if any(len(row["pronunciations"]) != 1 for row in entry_rows):
+            unlinked_ambiguity_keys += 1
+            unlinked_keys.append(f"{normalized_word}/{pos}")
+            continue
+
+        by_ipa: dict[str, list[dict[str, Any]]] = defaultdict(list)
+        for row in entry_rows:
+            ipa, _tags = row["pronunciations"][0]
+            by_ipa[ipa].append(row)
+
+        if len(by_ipa) < 2:
+            non_ambiguous_keys += 1
+            continue
+
+        resolvable_keys += 1
+        # The index key is normalized; using it as the profile word keeps output
+        # deterministic even when the source contains case variants in different orders.
+        display_word = normalized_word
+
+        for ipa, ipa_rows in sorted(by_ipa.items()):
+            merged: dict[str, list[str]] = {
+                "sense_ids": [],
+                "etymology_numbers": [],
+                "glosses": [],
+                "topics": [],
+                "tags": [],
+                "examples": [],
+                "synonyms": [],
+                "antonyms": [],
+            }
+            for row in ipa_rows:
+                for field_name, values in row["evidence"].items():
+                    merged[field_name].extend(values)
+            unique = {name: _unique_text(values) for name, values in merged.items()}
+            profiles.append(
+                ReadingProfile(
+                    word=display_word,
+                    pos=pos,
+                    reading_id=reading_id_for(language, normalized_word, pos, ipa),
+                    ipa=(ipa,),
+                    sense_ids=unique["sense_ids"],
+                    etymology_numbers=unique["etymology_numbers"],
+                    glosses=unique["glosses"],
+                    topics=unique["topics"],
+                    tags=unique["tags"],
+                    examples=unique["examples"],
+                    synonyms=unique["synonyms"],
+                    antonyms=unique["antonyms"],
+                )
+            )
+
+    profiles.sort(key=lambda profile: (normalize_word(profile.word), profile.pos, profile.ipa))
+    index = AmbiguityIndex(
+        language=normalize_word(language),
+        locale=locale,
+        profiles=tuple(profiles),
+    )
+    report = DiscoveryReport(
+        entries_scanned=entries_scanned,
+        keys_scanned=len(grouped),
+        ambiguous_keys=ambiguous_keys,
+        resolvable_keys=resolvable_keys,
+        unlinked_ambiguity_keys=unlinked_ambiguity_keys,
+        non_ambiguous_keys=non_ambiguous_keys,
+        entries_without_pronunciation=entries_without_pronunciation,
+        unlinked_keys=tuple(unlinked_keys),
+    )
+    return DiscoveryResult(index=index, report=report)
diff --git a/pronresolve/models.py b/pronresolve/models.py
new file mode 100644
index 0000000..b4d6054
--- /dev/null
+++ b/pronresolve/models.py
@@ -0,0 +1,167 @@
+"""Immutable public data models and JSON schema conversion."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+from collections.abc import Mapping
+
+INDEX_SCHEMA_VERSION = 1
+
+
+def _strings(value: Any) -> tuple[str, ...]:
+    if value is None:
+        return ()
+    if isinstance(value, str):
+        return (value,) if value else ()
+    try:
+        return tuple(str(item) for item in value if item is not None and str(item))
+    except TypeError:
+        return ()
+
+
+@dataclass(frozen=True, slots=True)
+class ReadingProfile:
+    word: str
+    pos: str
+    reading_id: str
+    ipa: tuple[str, ...]
+    sense_ids: tuple[str, ...] = ()
+    etymology_numbers: tuple[str, ...] = ()
+    glosses: tuple[str, ...] = ()
+    topics: tuple[str, ...] = ()
+    tags: tuple[str, ...] = ()
+    examples: tuple[str, ...] = ()
+    synonyms: tuple[str, ...] = ()
+    antonyms: tuple[str, ...] = ()
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "word": self.word,
+            "pos": self.pos,
+            "reading_id": self.reading_id,
+            "ipa": list(self.ipa),
+            "sense_ids": list(self.sense_ids),
+            "etymology_numbers": list(self.etymology_numbers),
+            "glosses": list(self.glosses),
+            "topics": list(self.topics),
+            "tags": list(self.tags),
+            "examples": list(self.examples),
+            "synonyms": list(self.synonyms),
+            "antonyms": list(self.antonyms),
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> ReadingProfile:
+        return cls(
+            word=str(value["word"]),
+            pos=str(value["pos"]),
+            reading_id=str(value["reading_id"]),
+            ipa=_strings(value.get("ipa")),
+            sense_ids=_strings(value.get("sense_ids")),
+            etymology_numbers=_strings(value.get("etymology_numbers")),
+            glosses=_strings(value.get("glosses")),
+            topics=_strings(value.get("topics")),
+            tags=_strings(value.get("tags")),
+            examples=_strings(value.get("examples")),
+            synonyms=_strings(value.get("synonyms")),
+            antonyms=_strings(value.get("antonyms")),
+        )
+
+
+@dataclass(frozen=True, slots=True)
+class AmbiguityIndex:
+    language: str
+    locale: str | None
+    profiles: tuple[ReadingProfile, ...]
+    schema_version: int = INDEX_SCHEMA_VERSION
+
+    def __post_init__(self) -> None:
+        if self.schema_version != INDEX_SCHEMA_VERSION:
+            raise ValueError(
+                f"unsupported ambiguity index schema {self.schema_version}; "
+                f"supported schema is {INDEX_SCHEMA_VERSION}"
+            )
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "schema_version": self.schema_version,
+            "language": self.language,
+            "locale": self.locale,
+            "profiles": [profile.to_dict() for profile in self.profiles],
+        }
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> AmbiguityIndex:
+        version = int(value.get("schema_version", 0))
+        if version != INDEX_SCHEMA_VERSION:
+            raise ValueError(
+                f"unsupported ambiguity index schema {version}; "
+                f"supported schema is {INDEX_SCHEMA_VERSION}"
+            )
+        raw_profiles = value.get("profiles", ())
+        if not isinstance(raw_profiles, list):
+            raise ValueError("'profiles' must be a JSON array")
+        profiles = tuple(
+            ReadingProfile.from_dict(item) for item in raw_profiles if isinstance(item, Mapping)
+        )
+        return cls(
+            language=str(value.get("language", "")),
+            locale=str(value["locale"]) if value.get("locale") is not None else None,
+            profiles=profiles,
+            schema_version=version,
+        )
+
+
+@dataclass(frozen=True, slots=True)
+class DiscoveryReport:
+    entries_scanned: int
+    keys_scanned: int
+    ambiguous_keys: int
+    resolvable_keys: int
+    unlinked_ambiguity_keys: int
+    non_ambiguous_keys: int
+    entries_without_pronunciation: int
+    unlinked_keys: tuple[str, ...] = ()
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "entries_scanned": self.entries_scanned,
+            "keys_scanned": self.keys_scanned,
+            "ambiguous_keys": self.ambiguous_keys,
+            "resolvable_keys": self.resolvable_keys,
+            "unlinked_ambiguity_keys": self.unlinked_ambiguity_keys,
+            "non_ambiguous_keys": self.non_ambiguous_keys,
+            "entries_without_pronunciation": self.entries_without_pronunciation,
+            "unlinked_keys": list(self.unlinked_keys),
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class DiscoveryResult:
+    index: AmbiguityIndex
+    report: DiscoveryReport
+
+
+@dataclass(frozen=True, slots=True)
+class CandidateScore:
+    reading_id: str
+    score: float
+    matched_terms: tuple[str, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class Resolution:
+    word: str
+    pos: str
+    reading_id: str
+    ipa: tuple[str, ...]
+    sense_ids: tuple[str, ...]
+    score: float
+    margin: float
+    evidence_terms: tuple[str, ...]
+    candidates: tuple[CandidateScore, ...]
+
+    @property
+    def selector(self) -> str:
+        return f"READING:{self.reading_id}"
diff --git a/pronresolve/normalization.py b/pronresolve/normalization.py
new file mode 100644
index 0000000..1687f13
--- /dev/null
+++ b/pronresolve/normalization.py
@@ -0,0 +1,63 @@
+"""Small, dependency-free text normalization helpers."""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from dataclasses import dataclass
+
+_WORD_RE = re.compile(r"[^\W_]+(?:['’][^\W_]+)?", re.UNICODE)
+
+# Generic function words only; this is not a word- or heteronym-specific list.
+STOPWORDS = frozenset(
+    """
+    a an and are as at be been being but by can could did do does for from had has have he her
+    hers him his how i if in into is it its may me might must my no nor not of on once only or
+    other our ours out over own same she should so some such than that the their theirs them
+    then there these they this those through to too under until up very was we were what when
+    where which while who whom why will with would you your yours
+    """.split()
+)
+
+
+def normalize_word(value: str) -> str:
+    return unicodedata.normalize("NFC", str(value)).casefold().strip()
+
+
+def normalize_pos(value: str | None) -> str:
+    normalized = " ".join(unicodedata.normalize("NFC", str(value or "")).strip().split())
+    return normalized.upper() if normalized else "ENTRY"
+
+
+def normalize_ipa(value: str) -> str:
+    normalized = unicodedata.normalize("NFC", str(value or "")).strip()
+    if len(normalized) >= 2 and (
+        (normalized[0] == "[" and normalized[-1] == "]")
+        or (normalized[0] == "/" and normalized[-1] == "/")
+    ):
+        normalized = normalized[1:-1]
+    return normalized.strip()
+
+
+def tokens(value: str) -> tuple[str, ...]:
+    return tuple(normalize_word(match.group(0)) for match in _WORD_RE.finditer(value or ""))
+
+
+@dataclass(frozen=True, slots=True)
+class TokenSpan:
+    text: str
+    normalized: str
+    start: int
+    end: int
+
+
+def token_spans(value: str) -> tuple[TokenSpan, ...]:
+    return tuple(
+        TokenSpan(
+            text=match.group(0),
+            normalized=normalize_word(match.group(0)),
+            start=match.start(),
+            end=match.end(),
+        )
+        for match in _WORD_RE.finditer(value or "")
+    )
diff --git a/pronresolve/resolver.py b/pronresolve/resolver.py
new file mode 100644
index 0000000..2a38218
--- /dev/null
+++ b/pronresolve/resolver.py
@@ -0,0 +1,201 @@
+"""Deterministic, explainable context-based pronunciation resolution."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+from .models import AmbiguityIndex, CandidateScore, ReadingProfile, Resolution
+from .normalization import STOPWORDS, normalize_pos, normalize_word, token_spans, tokens
+from .storage import load_index
+
+_FIELD_WEIGHTS = {
+    "glosses": 3.0,
+    "synonyms": 3.5,
+    "topics": 2.5,
+    "examples": 2.0,
+    "tags": 1.0,
+    "antonyms": 0.75,
+}
+
+
+class Resolver:
+    """Resolve a token only when lexical evidence and score margin are sufficient."""
+
+    def __init__(
+        self,
+        index: AmbiguityIndex | str | Path,
+        *,
+        min_score: float = 1.0,
+        min_margin: float = 0.75,
+    ) -> None:
+        self.index = load_index(index) if isinstance(index, (str, Path)) else index
+        if min_score < 0 or min_margin < 0:
+            raise ValueError("min_score and min_margin must be non-negative")
+        self.min_score = float(min_score)
+        self.min_margin = float(min_margin)
+        by_word: dict[str, list[ReadingProfile]] = defaultdict(list)
+        for profile in self.index.profiles:
+            by_word[normalize_word(profile.word)].append(profile)
+        self._by_word = dict(by_word)
+
+    @classmethod
+    def from_path(
+        cls,
+        path: str | Path,
+        *,
+        min_score: float = 1.0,
+        min_margin: float = 0.75,
+    ) -> Resolver:
+        return cls(path, min_score=min_score, min_margin=min_margin)
+
+    def resolve(
+        self,
+        text: str,
+        *,
+        start: int,
+        end: int,
+        pos: str | None = None,
+        lemma: str | None = None,
+    ) -> Resolution | None:
+        """Resolve the token spanning ``[start, end)`` in the original sentence.
+
+        Returns ``None`` for unknown words, insufficient evidence, a close score
+        tie, invalid offsets, or an omitted POS when the word has ambiguous POS groups.
+        """
+        if (
+            not isinstance(text, str)
+            or not isinstance(start, int)
+            or not isinstance(end, int)
+            or start < 0
+            or end <= start
+            or end > len(text)
+        ):
+            return None
+        target_text = lemma or text[start:end]
+        word = normalize_word(target_text)
+        if not word:
+            return None
+
+        profiles = self._by_word.get(word, [])
+        if not profiles:
+            return None
+
+        if pos is not None:
+            normalized_pos = normalize_pos(pos)
+            profiles = [
+                profile for profile in profiles if normalize_pos(profile.pos) == normalized_pos
+            ]
+        else:
+            pos_groups = {normalize_pos(profile.pos) for profile in profiles}
+            if len(pos_groups) != 1:
+                return None
+        if len(profiles) < 2:
+            return None
+
+        spans = token_spans(text)
+        target_index = next(
+            (index for index, span in enumerate(spans) if span.start < end and span.end > start),
+            sum(1 for span in spans if span.end <= start),
+        )
+        cue_distances: dict[str, int] = {}
+        for index, span in enumerate(spans):
+            if span.start < end and span.end > start:
+                continue
+            term = span.normalized
+            if not term or term in STOPWORDS or term == word:
+                continue
+            distance = abs(index - target_index)
+            prior = cue_distances.get(term)
+            if prior is None or distance < prior:
+                cue_distances[term] = distance
+
+        if not cue_distances:
+            return None
+
+        scored: list[CandidateScore] = []
+        profile_by_id = {profile.reading_id: profile for profile in profiles}
+        for profile in profiles:
+            field_tokens = {
+                field_name: {
+                    token
+                    for value in getattr(profile, field_name)
+                    for token in tokens(value)
+                    if token not in STOPWORDS
+                }
+                for field_name in _FIELD_WEIGHTS
+            }
+            score = 0.0
+            matched: list[str] = []
+            for term, distance in cue_distances.items():
+                matching_weight = max(
+                    (
+                        weight
+                        for field_name, weight in _FIELD_WEIGHTS.items()
+                        if term in field_tokens[field_name]
+                    ),
+                    default=0.0,
+                )
+                if matching_weight:
+                    # Adjacent evidence is strongest; distant cues still contribute.
+                    distance_factor = 1.0 / (1.0 + 0.15 * max(distance - 1, 0))
+                    score += matching_weight * distance_factor
+                    matched.append(term)
+            scored.append(
+                CandidateScore(
+                    reading_id=profile.reading_id,
+                    score=round(score, 6),
+                    matched_terms=tuple(matched),
+                )
+            )
+
+        scored.sort(key=lambda item: (-item.score, item.reading_id))
+        best = scored[0]
+        second_score = scored[1].score if len(scored) > 1 else 0.0
+        margin = round(best.score - second_score, 6)
+        if best.score < self.min_score or margin < self.min_margin:
+            return None
+
+        selected = profile_by_id[best.reading_id]
+        return Resolution(
+            word=selected.word,
+            pos=selected.pos,
+            reading_id=selected.reading_id,
+            ipa=selected.ipa,
+            sense_ids=selected.sense_ids,
+            score=best.score,
+            margin=margin,
+            evidence_terms=best.matched_terms,
+            candidates=tuple(scored),
+        )
+
+    def resolve_token(self, text: str, token: Any) -> Resolution | None:
+        """Convenience adapter for token objects or mappings with offsets and POS."""
+
+        def get(name: str, default: Any = None) -> Any:
+            if isinstance(token, Mapping):
+                return token.get(name, default)
+            return getattr(token, name, default)
+
+        # Prefer character offsets. For spaCy-like tokens, ``idx`` is the
+        # character start while ``start`` is a token index.
+        start = get("start_char", get("idx", get("start")))
+        end = get("end_char", get("end"))
+        lemma = get("lemma") or get("lemma_", None)
+        pos = get("pos") or get("pos_", None)
+        surface = get("text") or get("orth_", None)
+        if not isinstance(start, int):
+            return None
+        if not isinstance(end, int) and surface:
+            end = start + len(str(surface))
+        if not isinstance(end, int):
+            return None
+        return self.resolve(
+            text,
+            start=start,
+            end=end,
+            pos=str(pos) if pos else None,
+            lemma=str(lemma or surface) if (lemma or surface) else None,
+        )
diff --git a/pronresolve/storage.py b/pronresolve/storage.py
new file mode 100644
index 0000000..3592ae2
--- /dev/null
+++ b/pronresolve/storage.py
@@ -0,0 +1,28 @@
+"""JSON persistence for generated ambiguity indexes."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from .models import AmbiguityIndex
+
+
+def save_index(index: AmbiguityIndex, path: str | Path) -> Path:
+    destination = Path(path)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    temporary = destination.with_name(destination.name + ".tmp")
+    temporary.write_text(
+        json.dumps(index.to_dict(), ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    temporary.replace(destination)
+    return destination
+
+
+def load_index(path: str | Path) -> AmbiguityIndex:
+    source = Path(path)
+    value = json.loads(source.read_text(encoding="utf-8"))
+    if not isinstance(value, dict):
+        raise ValueError("ambiguity index root must be a JSON object")
+    return AmbiguityIndex.from_dict(value)
